{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "name": "NEUOJ 小助手",
  "version": "0.2.3",
  "version_name": "0.2.3",
  "description": "分析 NEUOJ 提交错误，支持向 CLion 导入题目和样例，并通过浏览器提交代码。",
  "icons": { "128": "logo.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "src/background.js" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true },
  "action": { "default_title": "NEUOJ 小助手", "default_icon": "logo.png" },
  "content_scripts": [
    {
      "matches": ["https://oj.neu.edu.cn/*", "https://webvpn.neu.edu.cn/*"],
      "js": ["vendor/markdown-it.umd.min.js", "vendor/texmath/texmath.js", "src/mathjax-config.js", "vendor/mathjax/tex-svg.js", "src/core.js", "src/content.js", "src/ide-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/texmath/texmath.css", "vendor/mathjax/ui/safe.js", "vendor/mathjax-newcm-font/svg/dynamic/*"],
      "matches": ["https://oj.neu.edu.cn/*", "https://webvpn.neu.edu.cn/*"]
    }
  ]
}
